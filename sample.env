# If you are reading this ⚠️ DO NOT PUT REAL KEYS HERE ⚠️ use vi .env instead

API_ID=
API_HASH=
TOKEN=
STRING1=
STRING2=
STRING3=
STRING4=
STRING5=
STRING6=
STRING7=
STRING8=
STRING9=
STRING10=
MONGO_URI=
API_URL=https://api.onegrab.fun
API_KEY=

# ArcMusic API (used only for YouTube search/download)
ARC_API_URL=https://api.arcmusic.fun
ARC_API_KEY=
SONG_DURATION_LIMIT=3600
OWNER_ID=
LOGGER_ID=
DEFAULT_SERVICE=youtube
DOWNLOADS_DIR=
DB_NAME=MusicBot
COOKIES_URL=
SUPPORT_GROUP=
SUPPORT_CHANNEL=
DEVS=
ENABLE_VPLAY=false

# Daily Mongo backups: zip is sent to this chat once a day at BACKUP_HOUR_UTC.
# Leave BACKUP_CHAT_ID unset (or 0) to disable the daily job; /backup and
# /restore (dev-only) still work on demand either way.
BACKUP_CHAT_ID=
BACKUP_HOUR_UTC=3

# Media cache cleanup: routine sweeps run on a fixed schedule regardless of
# this setting. If disk usage on the DOWNLOADS_DIR filesystem reaches this
# percentage, an extra cleanup runs immediately instead of waiting.
DISK_CLEANUP_THRESHOLD=90
